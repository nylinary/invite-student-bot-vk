# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа.
# Права: сообщения сообщества, документы, фотографии, управление сообществом.
VK_TOKEN=vk1.a.XXXX...

# id сообщества (необязательно — бот узнает его по токену)
GROUP_ID=

# Админы бота через запятую: можно id, можно короткий адрес страницы, можно вперемешку.
# id надёжнее (адрес человек может сменить), узнать свой — командой /id боту.
ADMIN_IDS=123456789, kakputinn

# PostgreSQL. На Railway — ссылка на сервис базы: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Схема в базе (по умолчанию public) — пригодится, если база общая
DB_SCHEMA=public

# Свой потолок сообщений в сутки. 0 (по умолчанию) — ограничений не выдумываем:
# бот слушает сигналы самого VK (ошибки 601 и 944) и тогда переносит хвост на завтра.
BROADCAST_DAILY_LIMIT=0

# Интент для тех, кому VK не даёт написать обычным сообщением (давно не писали сами).
BROADCAST_INTENT=non_promo_newsletter

# Как часто перечитывать диалоги сообщества (часы). 0 — только по кнопке в админке.
DIALOG_SYNC_HOURS=6

# Контакт организатора (в текстах бота)
ORGANIZER=vk.com/kakputinn
LOG_LEVEL=INFO
